# Evidence Lookup Service – Environment Configuration
# Copy this file to .env and uncomment / adjust the values you want to change.
# .env is listed in .gitignore and will never be committed to source control.

# ---------------------------------------------------------------------------
# Storage backend
# ---------------------------------------------------------------------------

# Backend type: 'memory' (default, no persistence) or 'file' (JSON files on disk)
# EVIDENCE_STORE_TYPE=memory

# Base directory for file-based persistence.
# Only used when EVIDENCE_STORE_TYPE=file.
# EVIDENCE_STORE_DIR=.evidence-store

# ---------------------------------------------------------------------------
# Retention settings
# ---------------------------------------------------------------------------

# Evidence metadata retention in days (default: 1825 = 5 years)
# EVIDENCE_RETENTION_DAYS=1825

# Raw snapshot retention in days (default: 365 = 1 year)
# SNAPSHOT_RETENTION_DAYS=365

# Fetch log retention in days (default: 180 = 6 months)
# LOG_RETENTION_DAYS=180
