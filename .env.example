# Evidence Lookup Service – Environment Configuration
# Copy this file to .env and uncomment / adjust the values you want to change.
# .env is listed in .gitignore and will never be committed to source control.

# ---------------------------------------------------------------------------
# Storage backend
# ---------------------------------------------------------------------------

# Backend type: 'memory' (default), 'file' (JSON files), or 'sqlite' (local DB)
# EVIDENCE_STORE_TYPE=memory

# Base directory for file-based persistence.
# Used by the file backend and as the default base directory for the SQLite DB path.
# EVIDENCE_STORE_DIR=.evidence-store

# SQLite database path.
# Only used when EVIDENCE_STORE_TYPE=sqlite.
# EVIDENCE_STORE_DB_PATH=.evidence-store/evidence-store.sqlite

# ---------------------------------------------------------------------------
# Discovery / fetch settings
# ---------------------------------------------------------------------------

# Search bootstrap endpoint.
# The service appends an URL-encoded query string to this value.
# EVIDENCE_SEARCH_ENDPOINT=https://duckduckgo.com/html/?q=

# Maximum number of search results/candidate URLs retained per lookup.
# EVIDENCE_SEARCH_MAX_RESULTS=5

# Maximum number of pages fetched/crawled per lookup.
# EVIDENCE_FETCH_MAX_PAGES=5

# Per-request fetch timeout in milliseconds.
# EVIDENCE_FETCH_TIMEOUT_MS=20000

# Optional custom user agent for fetches.
# EVIDENCE_FETCH_USER_AGENT=cernion-evidence-lookup/1.0

# ---------------------------------------------------------------------------
# LLM fallback settings
# ---------------------------------------------------------------------------

# Base URL for an OpenAI-compatible API.
# Ignored when LLM_ENDPOINT is set directly.
# LLM_BASE_URL=https://api.openai.com/v1

# Optional explicit chat completions endpoint.
# LLM_ENDPOINT=

# Model name for semantic extraction fallback.
# LLM_MODEL=

# API key for the LLM provider.
# LLM_API_KEY=

# LLM timeout in milliseconds.
# LLM_TIMEOUT_MS=30000

# Maximum number of source characters included in the LLM prompt.
# LLM_MAX_INPUT_CHARS=12000

# ---------------------------------------------------------------------------
# Retention settings
# ---------------------------------------------------------------------------

# Evidence metadata retention in days (default: 1825 = 5 years)
# EVIDENCE_RETENTION_DAYS=1825

# Raw snapshot retention in days (default: 365 = 1 year)
# SNAPSHOT_RETENTION_DAYS=365

# Fetch log retention in days (default: 180 = 6 months)
# LOG_RETENTION_DAYS=180
